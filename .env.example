# SignalField configuration. Copy to .env and fill only what you need.
# NEVER commit .env. Keys are read only on the server and are never returned
# to the browser or written to logs.

# ---- Local server ----
SIGNALFIELD_HOST=127.0.0.1
SIGNALFIELD_PORT=8790
SIGNALFIELD_TIMEZONE=Asia/Shanghai
# SQLite location. Defaults to ./data/signalfield.sqlite3
# SIGNALFIELD_DB_PATH=./data/signalfield.sqlite3
# Seed a read-only demo history on the very first start.
SIGNALFIELD_SEED_DEMO=true
# Demo pauses only make the progress UI observable. Set 0 for tests.
DEMO_STEP_DELAY_SECONDS=0.16

# ---- Real search provider ----
# deepseek = native DeepSeek Search (same LLM_API_KEY/base URL, no Tavily key)
# tavily   = dedicated Tavily Search API (requires TAVILY_API_KEY)
SEARCH_PROVIDER=deepseek

# ---- Tavily (only when SEARCH_PROVIDER=tavily) ----
TAVILY_API_KEY=
# Optional local provider prices for an estimated (not billed) cost display.
TAVILY_COST_PER_CALL_USD=0
LLM_INPUT_PRICE_PER_MTOK_USD=0
LLM_OUTPUT_PRICE_PER_MTOK_USD=0

# ---- OpenAI-compatible chat/completions ----
# DeepSeek is pre-filled and shares LLM_API_KEY with DeepSeek Search.
# For another vendor, replace base URL/model and leave LLM_THINKING empty.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.1
# Set false if your provider rejects response_format={"type":"json_object"}.
# The client still validates the returned JSON against Pydantic schemas.
LLM_JSON_MODE=true
# DeepSeek-specific: enabled / disabled. Leave empty for other vendors.
# JSON extraction is faster and cheaper with thinking disabled.
LLM_THINKING=disabled

# ---- Per-run hard budgets ----
MAX_SEARCHES=8
MAX_READS=15
MAX_MODEL_CALLS=9
MAX_GAP_ROUNDS=2
MAX_SECONDS=120
INITIAL_QUERY_LIMIT=5
INITIAL_READ_LIMIT=9
MAX_EVENTS=5

# ---- Optional daily caps (real mode only; demo does not consume them) ----
# 0 disables the cap. Usage is always recorded and shown in the UI.
DAILY_SEARCH_BUDGET=0
DAILY_READ_BUDGET=0
DAILY_MODEL_BUDGET=0

# ---- Reader safety ----
PAGE_MAX_BYTES=2000000
PAGE_TIMEOUT_SECONDS=18
LLM_TIMEOUT_SECONDS=45
SEARCH_RESULTS_PER_QUERY=5
